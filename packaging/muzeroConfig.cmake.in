@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(absl CONFIG REQUIRED)
find_dependency(nlohmann_json CONFIG REQUIRED)
find_dependency(tensorboard_logger CONFIG REQUIRED)
find_dependency(Torch CONFIG REQUIRED)

set(muzero_known_comps static shared)
set(muzero_comp_static NO)
set(muzero_comp_shared NO)
foreach (muzero_comp IN LISTS ${CMAKE_FIND_PACKAGE_NAME}_FIND_COMPONENTS)
    if (muzero_comp IN_LIST muzero_known_comps)
        set(muzero_comp_${muzero_comp} YES)
    else ()
        set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
            "muzero does not recognize component `${muzero_comp}`.")
        set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
        return()
    endif ()
endforeach ()

if (muzero_comp_static AND muzero_comp_shared)
    set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
        "muzero `static` and `shared` components are mutually exclusive.")
    set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
    return()
endif ()

set(muzero_static_targets "${CMAKE_CURRENT_LIST_DIR}/muzero-static-targets.cmake")
set(muzero_shared_targets "${CMAKE_CURRENT_LIST_DIR}/muzero-shared-targets.cmake")

macro(muzero_load_targets type)
    if (NOT EXISTS "${muzero_${type}_targets}")
        set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
            "muzero `${type}` libraries were requested but not found.")
        set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
        return()
    endif ()
    include("${muzero_${type}_targets}")
endmacro()

if (muzero_comp_static)
    muzero_load_targets(static)
elseif (muzero_comp_shared)
    muzero_load_targets(shared)
elseif (DEFINED muzero_SHARED_LIBS AND muzero_SHARED_LIBS)
    muzero_load_targets(shared)
elseif (DEFINED muzero_SHARED_LIBS AND NOT muzero_SHARED_LIBS)
    muzero_load_targets(static)
elseif (BUILD_SHARED_LIBS)
    if (EXISTS "${muzero_shared_targets}")
        muzero_load_targets(shared)
    else ()
        muzero_load_targets(static)
    endif ()
else ()
    if (EXISTS "${muzero_static_targets}")
        muzero_load_targets(static)
    else ()
        muzero_load_targets(shared)
    endif ()
endif ()
